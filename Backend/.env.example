# Variables de entorno necesarias para conectar con Supabase y configurar el servidor
# Copia este archivo como .env y rellena los valores reales

# Puerto en el que correrá el servidor Express
PORT=3000

# URL del proyecto en Supabase (se encuentra en Project Settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon de Supabase (anon key — para operaciones normales de base de datos)
# Se encuentra en Supabase → Settings → API → Project API keys → anon / public
SUPABASE_SERVICE_KEY=tu-anon-key-aqui

# Clave de admin de Supabase (service_role key — NUNCA exponerla en el frontend)
# Requerida para operaciones de Supabase Auth admin (listar/crear/eliminar usuarios)
# Se encuentra en Supabase → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Entorno: development | production
NODE_ENV=development
